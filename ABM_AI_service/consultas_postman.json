							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/update-label",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"update-label"
							]
						},
						"description": "Actualiza la etiqueta (label) de una imagen puntual en Qdrant, identificada por su embedding_id (el id del punto/vector, no el del vehículo). Devuelve 404 si el embedding_id no existe."
					},
					"response": []
				},
				{
