								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"color\": \"Gris\",\n    \"details\": [\"rayón puerta izquierda\", \"golpe leve paragolpes trasero\"]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/vehicles/8308f88e-55ac-46a0-8d41-7988f2d85248",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"vehicles",
								"8308f88e-55ac-46a0-8d41-7988f2d85248"
							]
						},
						"description": "Actualiza parcialmente brand/model/color/details/license_plate en TODAS las imágenes indexadas de un vehículo (solo se modifican los campos enviados en el body). Devuelve 404 si el vehicle_id no existe."
					},
					"response": []
				}
			]
		},
