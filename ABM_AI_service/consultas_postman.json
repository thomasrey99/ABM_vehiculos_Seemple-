								{
									"key": "files",
									"type": "file",
									"src": [],
									"description": "Segunda imagen"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/ingest",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"ingest"
							]
						},
						"description": "Sube e indexa un lote de imágenes asociadas a un vehículo. La patente (license_plate) NO se envía: se detecta automáticamente (ANPR) a partir de las imágenes del lote, con una confianza mínima configurable (por defecto 90%)."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Búsqueda",
			"item": [
				{
					"name": "Búsqueda por imagen (con detección de patente)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": [],
									"description": "Imagen a buscar. Si contiene una patente legible con alta confianza, el servicio la usa para buscar el vehículo exacto por patente; si no, cae a búsqueda por similitud visual."
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/search/image",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"search",
								"image"
							]
						},
						"description": "Busca vehículos similares. Primero intenta identificar una patente en la imagen (ANPR); si la encuentra con confianza suficiente, devuelve el vehículo por match exacto de patente. Si no, usa similitud visual con umbral dinámico."
					},
					"response": []
				},
				{
					"name": "Búsqueda filtrada por etiquetas (Imagen + Labels)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": [],
									"description": "Imagen a buscar (ej. foto del frente)"
								},
								{
									"key": "labels",
									"value": "frente",
									"description": "Etiqueta opcional 1",
									"type": "text"
								},
								{
									"key": "labels",
									"value": "atras",
									"description": "Etiqueta opcional 2",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/search/filtered",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"search",
								"filtered"
							]
						},
						"description": "Busca por similitud visual aplicando un filtro estricto de etiquetas en Qdrant. Si no se envían labels, usa un set de etiquetas por defecto (frente, frente 45 izquierda/derecha, atras, atras 45 izquierda/derecha)."
					},
					"response": []
				},
				{
					"name": "Búsqueda semántica por texto (híbrida)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "text",
									"value": "vehiculo marca toyota modelo corolla color blanco con rayon en puerta izquierda",
									"description": "Texto descriptivo en cualquier idioma",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/search/text",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"search",
								"text"
							]
						},
						"description": "Combina dos señales: (1) palabras clave extraídas del texto original, filtradas contra brand/model/color/details en Qdrant, y (2) el embedding CLIP del texto (traducido al inglés) para similitud visual-semántica. Devuelve los vehículos agrupados que superan el umbral dinámico."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Actualización",
			"item": [
				{
