					"request": {
						"method": "PATCH",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": [],
									"description": "Nueva imagen para regenerar el embedding"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/images/04d63bcd-9e9e-403a-91d1-78ca4fc77d45",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"images",
								"04d63bcd-9e9e-403a-91d1-78ca4fc77d45"
							]
						},
						"description": "Reemplaza la imagen (y su embedding) de un punto ya indexado, identificado por su embedding_id. Conserva el resto de los metadatos (vehicle_id, label, brand, model, color, license_plate, details) sin cambios. Devuelve 404 si el embedding_id no existe."
					},
					"response": []
				},
				{
					"name": "Actualizar metadatos de un vehículo",
					"request": {
						"method": "PATCH",
						"header": [
