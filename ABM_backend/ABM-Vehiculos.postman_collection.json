                  "pm.test('trae insurance_policy', function () { pm.expect(r.data).to.have.property('insurance_policy'); });",
                  "pm.test('embedding_status presente en imagenes', function () {",
                  "  if (r.data.images && r.data.images.length > 0) {",
                  "    pm.expect(r.data.images[0]).to.have.property('embedding_status');",
                  "  }",
                  "});"
                ]
