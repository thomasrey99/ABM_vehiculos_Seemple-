        {
          "name": "Delete Vehicle",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vehicles/{{vehicleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicles",
                "{{vehicleId}}"
              ]
            },
            "description": "Borrado en modo estricto: primero elimina los vectores del vehiculo en el servicio de reconocimiento (Qdrant) y las imagenes en Cloud Storage; solo si ambos pasos externos funcionan, borra el vehiculo de la base. Si cualquiera de los dos falla, devuelve 500 y el vehiculo NO se borra."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
