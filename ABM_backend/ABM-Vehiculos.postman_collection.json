    {
      "name": "Búsqueda por Imagen",
      "item": [
        {
          "name": "Search Vehicles By Image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vehicles/search/image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicles",
                "search",
                "image"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Adjuntá una imagen visualmente parecida a 'frente.jpg' del vehiculo creado",
                  "// en 'Create Vehicle - Success' para que aparezca como match."
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "let r = pm.response.json();",
                  "pm.test('success true', function () { pm.expect(r.success).to.be.true; });",
                  "pm.test('trae threshold', function () { pm.expect(r.data).to.have.property('threshold'); });",
                  "pm.test('trae matches (array)', function () { pm.expect(r.data.matches).to.be.an('array'); });",
                  "if (r.data.matches && r.data.matches.length > 0) {",
                  "  let firstMatch = r.data.matches[0];",
                  "  pm.test('cada match trae vehicle, score y matched_images', function () {",
                  "    pm.expect(firstMatch).to.have.property('vehicle');",
                  "    pm.expect(firstMatch).to.have.property('score');",
                  "    pm.expect(firstMatch.matched_images).to.be.an('array');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
